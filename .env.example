# Ejemplo de formato; sustituir los valores por la configuración local.
DATABASE_URL="mysql://usuario:contrasena@127.0.0.1:3306/nexoguard"

# Solo HTTP local; el destino MySQL Docker se configura en Compose.
NEXOGUARD_HTTP_MODE=local
FRONTEND_ORIGIN=http://127.0.0.1:3000
NEXOGUARD_CERT_WARNING_DAYS=30
# SSL Labs v4: correo institucional ya registrado; nunca NEXT_PUBLIC_.
SSLLABS_ENABLED=false
NEXOGUARD_SWAGGER_ENABLED=true
NEXOGUARD_MIGRATION_DATABASE_URL=
SSLLABS_EMAIL=
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
# En Docker, Compose monta la clave pública de MySQL (no la clave privada).
# NEXOGUARD_DB_PUBLIC_KEY_FILE=/run/nexoguard/mysql-public-key.pem
# Producción: NEXOGUARD_HTTP_MODE=production, FRONTEND_ORIGIN HTTPS
# y NEXOGUARD_CSRF_SECRET privado, aleatorio y de al menos 32 bytes.

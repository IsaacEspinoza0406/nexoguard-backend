# Public EXAMPLE only. Never put real secrets in this template.
COMPOSE_PROJECT_NAME=nexoguard-tls-example
PUBLIC_HOST=nexoguard.example.org
MYSQL_IMAGE=nexoguard-ec2-mysql:REEMPLAZAR_VERSION
BACK_IMAGE=nexoguard-ec2-back:REEMPLAZAR_VERSION
TRANSPORT_IMAGE=nexoguard-ec2-transport:REEMPLAZAR_VERSION
FRONT_IMAGE=nexoguard-ec2-front:REEMPLAZAR_VERSION
GATEWAY_IMAGE=nexoguard-ec2-gateway:REEMPLAZAR_VERSION
# Example paths relative to this Compose file. No private material is included.
PRIVATE_DIR=./secrets
LETSENCRYPT_DIR=./secrets/letsencrypt
ACME_DIR=./acme-public
FRONT_SOURCE_DIR=../../../front
# Example ranges only: check for overlap on the target host.
APP_SUBNET=10.88.10.0/24
APP_DYNAMIC_RANGE=10.88.10.128/25
GATEWAY_IP=10.88.10.2
DB_SUBNET=10.88.11.0/24
CONTROL_SUBNET=10.88.12.0/24
HOST_PUBLIC_IPV4=REEMPLAZAR_IP_PUBLICA
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# PRIVATE values intentionally empty. Do not use migration/admin identities at runtime.
DATABASE_URL=
NEXOGUARD_CSRF_SECRET=
NEXOGUARD_TRANSPORT_SECRET=
SSLLABS_ENABLED=false
SSLLABS_EMAIL=

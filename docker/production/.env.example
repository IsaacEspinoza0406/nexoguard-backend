# Plantilla exclusivamente pública. NO es un archivo listo para arrancar.
# Crear los secretos en Railway; no introducirlos en Git ni en argumentos de build.
NODE_ENV=production
HOST=::
PORT=3001
NEXOGUARD_HTTP_MODE=production
FRONTEND_ORIGIN=https://REEMPLAZAR.up.railway.app
NEXOGUARD_SWAGGER_ENABLED=false
NEXOGUARD_DB_MODE=production_tls
NEXOGUARD_DB_EXPECTED_HOST=mysql.railway.internal
NEXOGUARD_DB_EXPECTED_NAME=nexoguard
NEXOGUARD_DB_CA_FILE=/run/nexoguard/mysql-ca.pem
# DATABASE_URL: secreto privado, usuario nexoguard_runtime, host/nombre exactos, sin parámetros.
# NEXOGUARD_CSRF_SECRET: secreto privado aleatorio, al menos 32 bytes.
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
NEXOGUARD_TRANSPORT_MODE=remote
# Preferir HTTPS con certificado validado cuando no se use la misma malla Wireguard.
NEXOGUARD_TRANSPORT_URL=https://REEMPLAZAR
NEXOGUARD_TRANSPORT_PRIVATE_HTTP=false
# NEXOGUARD_TRANSPORT_SECRET: 32 bytes aleatorios codificados en base64url, privado.
# Sin TRUST_PROXY_IP se ignoran X-Forwarded-For: límite conservador compartido.
# Solo configurar NEXOGUARD_TRUST_PROXY_IP con la IP real exacta y comprobada del gateway.
NEXOGUARD_CERT_WARNING_DAYS=30
SSLLABS_ENABLED=false
# SSLLABS_EMAIL pertenece solo al transporte, no a Next ni al build.
# Migración: contenedor de una sola ejecución y secreto nexoguard_migrate independiente.
NEXOGUARD_MIGRATION_APPROVED=no

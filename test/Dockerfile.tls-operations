# Local operational test tool ONLY. Never deploy or give this socket to the app.
FROM docker:29.1.3-cli AS cli
FROM node:24.22.2-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl python3 util-linux systemd \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
ENTRYPOINT ["python3"]
